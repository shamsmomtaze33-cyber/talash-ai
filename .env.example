# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional key to enable live OpenAI ChatGPT routing and multi-model synthesis.
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Real Google OAuth 2.0 Web Credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FACEBOOK_APP_ID & FACEBOOK_APP_SECRET: Real Facebook Login App Credentials from Meta for Developers.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# OWNER_ACCESS_KEY: Optional server-side emergency/owner passkey for shamsmomtaze33@gmail.com.
OWNER_ACCESS_KEY=

# CUSTOM_DOMAIN & GOOGLE_SITE_VERIFICATION: Production domain & Google Search Console verification token.
CUSTOM_DOMAIN=
GOOGLE_SITE_VERIFICATION=

# Transactional Email Delivery for Email Verification & Password Recovery (SMTP or Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
MAIL_FROM=

